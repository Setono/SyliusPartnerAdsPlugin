{
    "name": "setono/sylius-partner-ads-plugin",
    "description": "Sylius plugin that integrates Partner Ads tracking.",
    "license": "MIT",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "partner ads",
        "setono"
    ],
    "require": {
        "php": ">=8.2",
        "knplabs/knp-menu": "^3.1",
        "php-http/discovery": "^1.20",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0",
        "setono/doctrine-orm-trait": "^1.4",
        "sylius/channel": "^2.0",
        "sylius/channel-bundle": "^2.0",
        "sylius/core": "^2.0",
        "sylius/core-bundle": "^2.0",
        "sylius/order": "^2.0",
        "sylius/resource-bundle": "^1.12",
        "sylius/ui-bundle": "^2.0",
        "symfony/config": "^6.4 || ^7.4",
        "symfony/dependency-injection": "^6.4 || ^7.4",
        "symfony/event-dispatcher": "^6.4 || ^7.4",
        "symfony/form": "^6.4 || ^7.4",
        "symfony/http-foundation": "^6.4 || ^7.4",
        "symfony/http-kernel": "^6.4 || ^7.4",
        "symfony/messenger": "^6.4 || ^7.4",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "api-platform/symfony": "^4.3.3",
        "kriswallsmith/buzz": "^1.2",
        "matthiasnoback/symfony-config-test": "^5.1 || ^6.0",
        "nyholm/psr7": "^1.8",
        "payum/core": "^1.7.5",
        "setono/sylius-plugin": "^2.0",
        "sylius/grid-bundle": "^1.15",
        "sylius/sylius": "~2.2.5",
        "symfony/debug-bundle": "^6.4 || ^7.4",
        "symfony/dotenv": "^6.4 || ^7.4",
        "symfony/intl": "^6.4 || ^7.4",
        "symfony/property-info": "^6.4 || ^7.4",
        "symfony/serializer": "^6.4 || ^7.4",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4",
        "symfony/webpack-encore-bundle": "^2.2"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Setono\\SyliusPartnerAdsPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Setono\\SyliusPartnerAdsPlugin\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "symfony/thanks": false
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "check-style": "ecs check",
        "fix-style": "ecs check --fix",
        "phpunit": "phpunit",
        "test": [
            "@check-style",
            "@analyse",
            "@phpunit"
        ]
    }
}
