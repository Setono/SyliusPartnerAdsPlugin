<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <mapped-superclass name="Setono\SyliusPartnerAdsPlugin\Model\Conversion" table="setono_sylius_partner_ads__conversion">

        <indexes>
            <index columns="state" name="idx_state"/>
        </indexes>

        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="partnerId" type="integer" />
        <field name="state" type="string" length="16" />
        <field name="tries" type="integer" />
        <field name="lastError" type="text" nullable="true" />
        <field name="notifiedAt" type="datetime_immutable" nullable="true" />
        <field name="createdAt" type="datetime_immutable" />

        <!--
            Deliberately many-to-one and NOT one-to-one/unique. A unique constraint on the order could only ever
            fail inside the customer's checkout request (two concurrent checkout-complete requests for the same cart
            both inserting a conversion), and failing there fails the checkout. See CreateConversionSubscriber for
            the full reasoning. Uniqueness of *notifications* is enforced by ProcessConversionsCommand instead.
        -->
        <many-to-one field="order" target-entity="Sylius\Component\Core\Model\OrderInterface">
            <join-column name="order_id" nullable="false" on-delete="CASCADE" />
        </many-to-one>
    </mapped-superclass>

</doctrine-mapping>
